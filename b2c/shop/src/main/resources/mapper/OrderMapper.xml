<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zsl.b2cmall.shop.dao.OrderMapper">

    <sql id="bFilter">
        <where>
            shop_id = #{shopId} AND deleted = 0
            <if test="orderNo != null and orderNo != ''">
                AND order_no = #{orderNo}
            </if>
            <if test="orderType != null and orderType != ''">
                AND order_type = #{orderType}
            </if>
            <if test="orderCategory != null and orderCategory != ''">
                AND order_category = #{orderCategory}
            </if>
            <if test="status != null and status != '' and status != 'ALL'">
                AND status = #{status}
            </if>
            <if test="receiverName != null and receiverName != ''">
                AND buyer_name LIKE '%' || #{receiverName} || '%'
            </if>
            <if test="phone != null and phone != ''">
                AND buyer_phone LIKE '%' || #{phone} || '%'
            </if>
            <if test="payType != null and payType != ''">
                AND pay_type = #{payType}
            </if>
            <if test="afterSaleStatus != null and afterSaleStatus != ''">
                AND after_sale_status = #{afterSaleStatus}
            </if>
            <if test="logisticsType != null and logisticsType != ''">
                AND logistics_type = #{logisticsType}
            </if>
            <if test="storeName != null and storeName != ''">
                AND store_name LIKE '%' || #{storeName} || '%'
            </if>
            <if test="startDate != null and startDate != ''">
                AND date(created_at) &gt;= date(#{startDate})
            </if>
            <if test="endDate != null and endDate != ''">
                AND date(created_at) &lt;= date(#{endDate})
            </if>
        </where>
    </sql>

    <select id="queryPage" parameterType="com.zsl.b2cmall.shop.request.OrderQueryVO"
            resultType="com.zsl.b2cmall.shop.entity.OrderPO">
        SELECT * FROM tb_order
        <include refid="bFilter"/>
        ORDER BY created_at DESC, id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>

    <select id="countQuery" parameterType="com.zsl.b2cmall.shop.request.OrderQueryVO" resultType="long">
        SELECT COUNT(*) FROM tb_order
        <include refid="bFilter"/>
    </select>

    <select id="queryAll" parameterType="com.zsl.b2cmall.shop.request.OrderQueryVO"
            resultType="com.zsl.b2cmall.shop.entity.OrderPO">
        SELECT * FROM tb_order
        <include refid="bFilter"/>
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="findByIds" resultType="com.zsl.b2cmall.shop.entity.OrderPO">
        SELECT * FROM tb_order WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="customerList" resultType="com.zsl.b2cmall.shop.entity.OrderPO">
        SELECT * FROM tb_order
        WHERE user_id = #{userId} AND deleted = 0
        <if test="status != null and status != '' and status != 'ALL'">
            AND status = #{status}
        </if>
        <if test="orderNo != null and orderNo != ''">
            AND order_no = #{orderNo}
        </if>
        ORDER BY created_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="customerCount" resultType="long">
        SELECT COUNT(*) FROM tb_order
        WHERE user_id = #{userId} AND deleted = 0
        <if test="status != null and status != '' and status != 'ALL'">
            AND status = #{status}
        </if>
        <if test="orderNo != null and orderNo != ''">
            AND order_no = #{orderNo}
        </if>
    </select>

</mapper>
